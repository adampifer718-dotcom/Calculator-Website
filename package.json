{
  "name": "calcnest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "backlog:report": "node --experimental-strip-types --no-warnings scripts/backlog-report.mjs",
    "i18n:sync": "node scripts/sync-translations.mjs",
    "i18n:report": "UPDATE_REPORT=1 vitest run src/i18n/report.test.ts",
    "converters:report": "UPDATE_REPORT=1 vitest run src/converters/inventory.test.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=20.9"
  },
  "overrides": {
    "playwright-core": "1.56.1"
  }
}
